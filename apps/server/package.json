{
  "name": "@dss/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "files": [
    "dist",
    "migrations"
  ],
  "scripts": {
    "dev": "tsx src/main.ts",
    "preview": "tsx src/preview.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "tsx --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "admin:create": "tsx src/bootstrap-admin.ts",
    "local:setup": "tsx src/local-setup.ts",
    "verify:transport": "tsx tools/load-transport.ts"
  },
  "dependencies": {
    "@dss/protocol": "workspace:*",
    "@dss/rules": "workspace:*",
    "@electric-sql/pglite": "^0.3.14",
    "@fastify/cors": "^11.0.1",
    "@fastify/rate-limit": "^10.3.0",
    "@fastify/static": "^8.2.0",
    "@fastify/websocket": "^11.2.0",
    "decimal.js": "^10.6.0",
    "fastify": "^5.4.0",
    "pg": "^8.16.0",
    "protobufjs": "^7.5.4",
    "sharp": "^0.34.5",
    "ws": "^8.18.3",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@types/pg": "^8.15.0",
    "@types/ws": "^8.18.1",
    "tsx": "^4.20.0",
    "typescript": "^5.8.3"
  }
}
